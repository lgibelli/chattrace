# Copy to scripts/release.env (git-ignored) and fill in. Read by the build scripts.
# macOS signing + notarization
export MACOS_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
export APPLE_API_KEY_PATH="$HOME/path/to/AuthKey_XXXXXXXXXX.p8"
export APPLE_API_KEY_ID="XXXXXXXXXX"
export APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
# Developer ID certificate + private key, used by scripts/set-ci-secrets.sh to build the CI .p12
export MACOS_CERT_CER="$HOME/path/to/developerID_application.cer"
export MACOS_CERT_KEY="$HOME/path/to/developer_id.key"
# minisign key that signs SHA256SUMS for the in-app updater (public key: assets/updater.pub)
export MINISIGN_KEY_PATH="$HOME/.chattrace-keys/chattrace-updater.key"
